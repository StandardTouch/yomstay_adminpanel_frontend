# Single-page-app fallback and HTTPS enforcement.
#
# admin.yomstay.com is served by LiteSpeed, not by the nginx container in the
# Dockerfile, so the try_files rule there never applies and any direct URL
# (for example /dashboard/settings) returns the host 404 page instead of the
# app. Vite copies this file into dist/, so the built upload carries the rule.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS. Clerk relies on the Web Locks API (navigator.locks), which the
  # browser only exposes in a secure context. Over plain http the panel throws
  # "undefined is not an object (evaluating 'navigator.locks.request')" and
  # shows an "API Connection Error" screen instead of the sign-in form.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Leave real files and directories alone
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # A hashed build asset that is missing must return 404, not fall through to
  # index.html: the browser refuses HTML served as a module script
  # ("Expected a JavaScript-or-Wasm module script but the server responded
  # with a MIME type of text/html") and the whole panel renders blank.
  RewriteRule ^assets/ - [R=404,L]

  # Everything else is handled by the app
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "env\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # index.html names the hashed bundles, so a cached copy can point the browser
  # at assets that no longer exist on the host after a new build is uploaded.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
